# Copy to .env and set the four passwords before starting Docker.
# Use URL-safe passwords if you include them in connection URLs.
POSTGRES_PASSWORD=
SUPPORT_DB_PASSWORD=
SUPPORT_READONLY_PASSWORD=
ANALYTICS_DB_PASSWORD=
POSTGRES_PORT=5432

# Local Python applications connect through localhost.
# Replace the password placeholders with the matching values above.
SUPPORT_DATABASE_URL=postgresql://support_app:REPLACE_ME@localhost:5432/support
SUPPORT_READONLY_DATABASE_URL=postgresql://support_reader:REPLACE_ME@localhost:5432/support
ANALYTICS_DATABASE_URL=postgresql://analytics_app:REPLACE_ME@localhost:5432/analytics
TRANSCRIPTS_DIR=runtime/transcripts
DEMO_NOW=2026-10-31T12:00:00Z
GEMINI_API_KEY=
