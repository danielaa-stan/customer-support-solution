# Copy this file to .env and fill in the values. Never commit .env.

# LLM key (Gemma 4 through the Gemini API)
GEMINI_API_KEY=
# Agent settings (model, thinking level, logging) are in agent/config/settings.toml.
# Any of them can be overridden here, e.g. LLM_REASONING_EFFORT=low

# Shared paths (contracts/01-ownership.md)
SUPPORT_DB_PATH=runtime/support.db
TRANSCRIPTS_DIR=runtime/transcripts
ANALYTICS_DB_PATH=runtime/analytics.db
DEMO_NOW=2026-10-31T12:00:00Z

# Command B uses to start A's MCP server over stdio
MCP_SERVER_COMMAND=dotnet run --project server
