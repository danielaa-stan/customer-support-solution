# Copy this file to .env and fill in the values. Never commit .env.
# Use URL-safe passwords if you include them in connection URLs.

# LLM key (Gemma 4 through the Gemini API)
GEMINI_API_KEY=
# Agent settings (model, thinking level, logging) are in agent/config/settings.toml.
# Any of them can be overridden here, e.g. LLM_REASONING_EFFORT=low

# PostgreSQL passwords (set all four before starting Docker)
POSTGRES_PASSWORD=
SUPPORT_DB_PASSWORD=
SUPPORT_READONLY_PASSWORD=
ANALYTICS_DB_PASSWORD=
POSTGRES_PORT=5432

# Local applications connect through localhost.
# Replace the password placeholders with the matching values above.
SUPPORT_DATABASE_URL=postgresql://support_app:REPLACE_ME@localhost:5432/support
SUPPORT_READONLY_DATABASE_URL=postgresql://support_reader:REPLACE_ME@localhost:5432/support
ANALYTICS_DATABASE_URL=postgresql://analytics_app:REPLACE_ME@localhost:5432/analytics

# Shared paths
TRANSCRIPTS_DIR=runtime/transcripts
DEMO_NOW=2026-10-31T12:00:00Z

# SQLite fallback, used only when SUPPORT_DATABASE_URL is not set.
SUPPORT_DB_PATH=runtime/support.db

# Command B uses to start A's MCP server over stdio. Build first: dotnet build -c Release server/SupportServer.slnx
# (not "dotnet run": build output on stdout would corrupt the MCP stream, see server/README.md)
MCP_SERVER_COMMAND=dotnet server/SupportServer/bin/Release/net10.0/SupportServer.dll
